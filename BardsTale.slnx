<Solution>
  <Folder Name="/src/">
    <Project Path="src/BardsTale.Core/BardsTale.Core.csproj" />
    <Project Path="src/BardsTale.UI/BardsTale.UI.csproj" />
    <Project Path="src/BardsTale.Desktop/BardsTale.Desktop.csproj" />
    <Project Path="src/BardsTale.Android/BardsTale.Android.csproj" />
    <Project Path="src/BardsTale.iOS/BardsTale.iOS.csproj" />
    <!-- Note: BardsTale.Android needs the 'android' workload (+ JDK/Android SDK), and
         BardsTale.iOS needs the 'ios' workload + Xcode with its license accepted
         (sudo xcodebuild -license accept; sudo xcode-select -s /Applications/Xcode.app).
         A full `dotnet build`/`dotnet test` of this solution requires both.
         BardsTale.Browser (WebAssembly) is still omitted; build it directly with
         dotnet run on src/BardsTale.Browser (after installing wasm-tools). -->
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/BardsTale.Tests/BardsTale.Tests.csproj" />
  </Folder>
</Solution>
