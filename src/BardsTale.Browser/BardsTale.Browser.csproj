<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- WebAssembly head. Requires the one-time workload:  dotnet workload install wasm-tools
         If your installed wasm workload targets .NET 10, change this to net10.0-browser. -->
    <TargetFramework>net9.0-browser</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WasmMainJSPath>wwwroot/main.js</WasmMainJSPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Browser" Version="11.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BardsTale.UI\BardsTale.UI.csproj" />
  </ItemGroup>
</Project>
