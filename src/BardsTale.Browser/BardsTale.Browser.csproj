<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- WebAssembly head. Requires the one-time workload:  dotnet workload install wasm-tools
         If your installed wasm workload targets .NET 10, change this to net10.0-browser. -->
    <TargetFramework>net9.0-browser</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WasmMainJSPath>wwwroot/main.js</WasmMainJSPath>
    <!-- The reflection-based ViewLocator (Type.GetType) and System.Text.Json aren't
         trim-safe, so disable trimming to keep the published bundle correct. Re-enabling
         it later means adding trim hints / a JsonSerializerContext. -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Tells `dotnet run`'s WasmAppHost which host to launch and which page to open. -->
    <DefaultWasmHostConfig>browser</DefaultWasmHostConfig>
  </PropertyGroup>

  <ItemGroup>
    <HostConfig Include="browser" host="browser" html-path="index.html" />
  </ItemGroup>

  <!-- Deploy our static web files (index.html, PWA manifest/service worker, the
       IndexedDB module, icon) to the AppBundle root. main.js is already deployed
       via WasmMainJSPath, so exclude it to avoid a duplicate. -->
  <ItemGroup>
    <WasmExtraFilesToDeploy Include="wwwroot\**" Exclude="wwwroot\main.js"
                            TargetPath="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Browser" Version="11.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BardsTale.UI\BardsTale.UI.csproj" />
  </ItemGroup>
</Project>
