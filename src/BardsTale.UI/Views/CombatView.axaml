<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BardsTale.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="520"
             x:Class="BardsTale.UI.Views.CombatView"
             x:DataType="vm:CombatViewModel">

    <Border Margin="16" Padding="16" CornerRadius="6"
            Background="#141824" BorderBrush="#7A2E2E" BorderThickness="2">
        <Grid RowDefinitions="Auto,*,Auto">

            <TextBlock Grid.Row="0" Text="⚔  COMBAT" FontSize="20" FontWeight="Bold"
                       Foreground="#E0857A" Margin="0,0,0,10"/>

            <Grid Grid.Row="1" ColumnDefinitions="190,*,250">

                <!-- Enemy groups (target selection) -->
                <Border Grid.Column="0" Margin="0,0,12,0" Padding="6" Background="#1C2030" CornerRadius="4">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Target" Foreground="#9AA0B5"
                                   FontSize="12" Margin="2,0,0,6"/>
                        <ListBox ItemsSource="{Binding Groups}"
                                 SelectedIndex="{Binding SelectedGroupIndex, Mode=TwoWay}"
                                 Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:MonsterGroupViewModel">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" FontWeight="Bold" Foreground="#E8E9F0"/>
                                        <TextBlock Text="{Binding HealthText}" FontSize="11" Foreground="#9AA0B5"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Current actor's orders -->
                <DockPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Prompt}" FontWeight="Bold"
                               Foreground="#E8C56B" TextWrapping="Wrap" Margin="0,0,0,2"/>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding ActorSpText}" FontSize="11" Foreground="#8FB7FF"
                               FontFamily="Consolas,monospace" IsVisible="{Binding HasActorSp}" Margin="0,0,0,8"/>

                    <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="6" Background="#0E1018"
                            CornerRadius="4">
                        <ItemsControl ItemsSource="{Binding Orders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="11" Foreground="#7E97A8"
                                               FontFamily="Consolas,monospace"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <Panel>
                        <!-- Action options -->
                        <ScrollViewer IsVisible="{Binding !IsChoosingTarget}">
                            <ItemsControl ItemsSource="{Binding Options}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CombatActionOptionViewModel">
                                        <Button Margin="0,0,0,4" Padding="10,6" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Command="{Binding $parent[ItemsControl].((vm:CombatViewModel)DataContext).ChooseActionCommand}"
                                                CommandParameter="{Binding}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Label}" FontWeight="Bold" Foreground="{Binding LabelBrush}"/>
                                                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#9AA0B5"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding CostText}" IsVisible="{Binding ShowsCost}"
                                                           FontWeight="Bold" Foreground="{Binding CostBrush}"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Ally target picker -->
                        <DockPanel IsVisible="{Binding IsChoosingTarget}">
                            <Button DockPanel.Dock="Bottom" Content="Cancel" Margin="0,6,0,0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Command="{Binding CancelTargetCommand}"/>
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding AllyTargets}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AllyTargetViewModel">
                                            <Button Margin="0,0,0,4" Padding="10,6" HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left" IsEnabled="{Binding IsValid}"
                                                    Command="{Binding $parent[ItemsControl].((vm:CombatViewModel)DataContext).ChooseAllyTargetCommand}"
                                                    CommandParameter="{Binding}">
                                                <Grid ColumnDefinitions="*,Auto,Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold"
                                                               Foreground="#E8E9F0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding StatusTag}" FontSize="11"
                                                               Foreground="#9AA0B5" Margin="0,0,10,0"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Health}" FontSize="11"
                                                               Foreground="#C0566B"/>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Panel>
                </DockPanel>

                <!-- Combat log -->
                <Border Grid.Column="2" Padding="8" Background="#0E1018" CornerRadius="4">
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Log}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="#C8D6CC"
                                               FontFamily="Consolas,monospace" FontSize="12" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Party-level controls -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0"
                        IsVisible="{Binding !IsOver}">
                <Button Content="Auto (rest attack/cast)" Command="{Binding AutoCommand}"/>
                <Button Content="Undo Last" Command="{Binding UndoLastCommand}"/>
                <Button Content="Flee" Command="{Binding FleeCommand}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
