<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BardsTale.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
             x:Class="BardsTale.UI.Views.MainView"
             x:DataType="vm:MainWindowViewModel"
             Focusable="True"
             Background="#11131A">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <LayoutTransformControl>
        <LayoutTransformControl.LayoutTransform>
            <ScaleTransform ScaleX="{Binding Settings.UiScale}" ScaleY="{Binding Settings.UiScale}"/>
        </LayoutTransformControl.LayoutTransform>
    <Grid Margin="12" RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="2,0,0,10">
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <TextBlock Text="THE BARD'S TALE" FontSize="22" FontWeight="Bold" Foreground="#E8C56B"/>
                <Border IsVisible="{Binding IsIronman}" Background="#3A1416" BorderBrush="#C0566B" BorderThickness="1"
                        CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                    <TextBlock Text="☠ IRONMAN" FontSize="11" FontWeight="Bold" Foreground="#E08A8A"/>
                </Border>
                <Border IsVisible="{Binding IsNewGamePlus}" Background="#2A1C3A" BorderBrush="#9B7FE0" BorderThickness="1"
                        CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AscensionBadge}" FontSize="11" FontWeight="Bold" Foreground="#C8AEF0"/>
                </Border>
                <Border IsVisible="{Binding ShowDifficultyBadge}" Background="#1C2A1E" BorderBrush="#7FB069" BorderThickness="1"
                        CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DifficultyBadge}" FontSize="11" FontWeight="Bold" Foreground="#A8D88A"/>
                </Border>
                <Border IsVisible="{Binding IsChallengeRun}" Background="#2A2410" BorderBrush="#D8B45A" BorderThickness="1"
                        CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ChallengeBadge}" FontSize="11" FontWeight="Bold" Foreground="#E8C56B"/>
                </Border>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Foreground="#A9D0B0"
                       VerticalAlignment="Center" Margin="16,0" FontFamily="Consolas,monospace"/>
            <Button Grid.Column="2" Content="{Binding RenownBadge}" Command="{Binding ShowAchievementsCommand}" Margin="0,0,6,0"/>
            <Button Grid.Column="3" Content="📜 Quests (J)" Command="{Binding ShowQuestLogCommand}" Margin="0,0,6,0"/>
            <Button Grid.Column="4" Content="📖 Bestiary (B)" Command="{Binding ShowBestiaryCommand}" Margin="0,0,6,0"/>
            <Button Grid.Column="5" Content="🔗 Sets (K)" Command="{Binding ShowSetCodexCommand}" Margin="0,0,6,0"/>
            <Button Grid.Column="6" Content="🎯 Daily" Command="{Binding ShowChallengeCommand}" Margin="0,0,6,0"/>
            <Button Grid.Column="7" Content="❔ Help" Command="{Binding ShowHelpCommand}" Margin="0,0,6,0"
                    ToolTip.Tip="How to play (F1)"/>
            <Button Grid.Column="8" Content="⚙ Settings" Command="{Binding ShowSettingsCommand}" Margin="0,0,6,0"/>
            <Button Grid.Column="9" Content="Save" Command="{Binding ShowSaveSlotsCommand}" Margin="0,0,6,0"
                    IsEnabled="{Binding ManualSavesAllowed}"/>
            <Button Grid.Column="10" Content="Load" Command="{Binding ShowLoadSlotsCommand}"
                    IsEnabled="{Binding ManualSavesAllowed}"/>
        </Grid>

        <Panel Grid.Row="1">
            <ContentControl Content="{Binding CurrentView}"/>

            <!-- Victory / credits screen -->
            <Border IsVisible="{Binding IsGameWon}" Background="#F00B0D14">
                <Border Width="580" MaxHeight="640" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Background="#1A1626" BorderBrush="#E8C56B" BorderThickness="2" CornerRadius="8" Padding="28">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center"
                                    Spacing="12" Margin="0,16,0,0">
                            <Button Content="⮕ New Game+ (carry your party)" Command="{Binding NewGamePlusCommand}"
                                    Padding="16,8" Background="#3A2C5A" Foreground="#E9E0FF" FontWeight="Bold"/>
                            <Button Content="Begin a New Adventure" Command="{Binding NewGameCommand}"
                                    Padding="16,8" Background="#3A5A3A" Foreground="#E9FFE0" FontWeight="Bold"/>
                        </StackPanel>
                        <ScrollViewer>
                            <StackPanel Spacing="14">
                                <TextBlock Text="✦ VICTORY ✦" FontSize="30" FontWeight="Bold"
                                           Foreground="#E8C56B" HorizontalAlignment="Center"/>
                                <Border IsVisible="{Binding ShowChallengeResult}" Background="#2A2410" BorderBrush="#D8B45A"
                                        BorderThickness="1" CornerRadius="4" Padding="10,6" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding ChallengeResultText}" Foreground="#E8C56B" FontWeight="Bold"
                                               FontSize="13" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="#D8C58A" FontSize="14"
                                           Text="Mangar the Mad is destroyed. The eternal winter melts from the streets of Skara Brae, and the people hail your party as heroes. Your tale will be sung in every tavern for a hundred years."/>

                                <TextBlock Text="— Your Heroes —" Foreground="#8FB7FF" FontWeight="Bold"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <ItemsControl ItemsSource="{Binding VictoryParty}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="#E8E9F0" FontSize="13"
                                                       HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="— The Tally —" Foreground="#8FB7FF" FontWeight="Bold"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <ItemsControl ItemsSource="{Binding VictoryStats}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="#C7CBDA" FontSize="13"
                                                       FontFamily="Consolas,monospace" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="— Credits —" Foreground="#8FB7FF" FontWeight="Bold"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="#9AA0B5" FontSize="12"
                                           Text="THE BARD'S TALE — a fan re-implementation of the 1985 classic.&#10;Built with Avalonia and .NET 9.&#10;Engine, town, dungeon, and combat by your friendly AI adventuring companion.&#10;Original game by Interplay Productions."/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Border>

            <!-- Ironman game-over screen -->
            <Border IsVisible="{Binding IsGameOver}" Background="#F00B0D14">
                <Border Width="520" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Background="#1A1216" BorderBrush="#C0566B" BorderThickness="2" CornerRadius="8" Padding="28">
                    <StackPanel Spacing="14">
                        <TextBlock Text="☠ THE PARTY HAS FALLEN ☠" FontSize="26" FontWeight="Bold"
                                   Foreground="#E08A8A" HorizontalAlignment="Center"/>
                        <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="#D8B0B0" FontSize="14"
                                   Text="Your Ironman run ends in the dark of the catacombs. There is no reloading, no revival — the save has been wiped. Such is the price of glory sought without a safety net."/>
                        <Border IsVisible="{Binding ShowChallengeResult}" Background="#2A2410" BorderBrush="#D8B45A"
                                BorderThickness="1" CornerRadius="4" Padding="10,6" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding ChallengeResultText}" Foreground="#E8C56B" FontWeight="Bold"
                                       FontSize="13" HorizontalAlignment="Center"/>
                        </Border>
                        <Button Content="Begin a New Adventure" Command="{Binding NewGameCommand}"
                                HorizontalAlignment="Center" Margin="0,8,0,0" Padding="16,8"
                                Background="#3A5A3A" Foreground="#E9FFE0" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Border>

            <!-- Seeded daily challenge -->
            <Border IsVisible="{Binding IsChallengePanelOpen}" Background="#E60B0D14">
                <Border Width="480" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Background="#161A24" BorderBrush="#D8B45A" BorderThickness="2" CornerRadius="6" Padding="20">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="🎯 Daily Challenge" FontSize="18" FontWeight="Bold"
                                       Foreground="#E8C56B" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Close" Command="{Binding CloseChallengeCommand}"/>
                        </Grid>
                        <TextBlock TextWrapping="Wrap" Foreground="#CFD3E0" FontSize="13"
                                   Text="A seeded run: the same dungeon, monsters and loot for everyone on a given seed — played with the ready-made party, on Normal, to the death. Score by how deep you delve and how much you slay. Share a seed to challenge a friend."/>
                        <TextBlock Text="{Binding TodaysSeedText}" Foreground="#8FB7FF" FontSize="12" FontFamily="Consolas,monospace"/>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                            <TextBox Grid.Column="0" Text="{Binding ChallengeSeedInput, Mode=TwoWay}"
                                     Watermark="Enter a seed…" HorizontalAlignment="Stretch"/>
                            <Button Grid.Column="1" Content="Use today's" Command="{Binding UseTodaysSeedCommand}" Margin="6,0,0,0"/>
                        </Grid>
                        <TextBlock Text="{Binding ChallengeBestText}" Foreground="#D8B45A" FontSize="12"/>
                        <Button Content="Start Challenge" Command="{Binding StartChallengeCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,4,0,0"
                                Padding="0,8" Background="#3A3320" Foreground="#F0E0B0" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Border>

            <!-- Help / tutorial overlay -->
            <Border IsVisible="{Binding IsHelpOpen}" Background="#E60B0D14">
                <Border Width="640" MaxHeight="660" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Background="#161A24" BorderBrush="#6FD0E8" BorderThickness="2" CornerRadius="8" Padding="22">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                            <TextBlock Grid.Column="0" Text="❔ How to Play" FontSize="20" FontWeight="Bold"
                                       Foreground="#E8C56B" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Close (Esc)" Command="{Binding CloseHelpCommand}"/>
                        </Grid>
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding HelpSections}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:HelpSectionViewModel">
                                        <StackPanel Margin="0,0,0,14">
                                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold"
                                                       Foreground="#6FD0E8" Margin="0,0,0,4"/>
                                            <ItemsControl ItemsSource="{Binding Lines}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnDefinitions="Auto,*" Margin="4,0,0,3">
                                                            <TextBlock Grid.Column="0" Text="•" Foreground="#8FB7FF" Margin="0,0,7,0"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding}" Foreground="#CFD3E0"
                                                                       FontSize="13" TextWrapping="Wrap"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Border>

            <!-- Save / load slot picker -->
            <Border IsVisible="{Binding IsSlotPanelOpen}" Background="#E60B0D14">
                <Border Width="520" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Background="#161A24" BorderBrush="#3A3F52" BorderThickness="2" CornerRadius="6" Padding="18">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                            <TextBlock Grid.Column="0" Text="{Binding SlotPanelTitle}" FontSize="18"
                                       FontWeight="Bold" Foreground="#E8C56B" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Close" Command="{Binding CloseSlotsCommand}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Slots}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SaveSlotViewModel">
                                    <Border Margin="0,0,0,8" Padding="10,8" CornerRadius="4" Background="#222634">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Foreground="#E8E9F0"/>
                                                <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="#9AA0B5"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Save here"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).SaveToSlotCommand}"
                                                    CommandParameter="{Binding}">
                                                <Button.IsVisible>
                                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                        <Binding Path="$parent[ItemsControl].((vm:MainWindowViewModel)DataContext).IsSaveMode"/>
                                                        <Binding Path="!IsAutosave"/>
                                                    </MultiBinding>
                                                </Button.IsVisible>
                                            </Button>
                                            <Button Grid.Column="1" Content="Load"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).LoadFromSlotCommand}"
                                                    CommandParameter="{Binding}">
                                                <Button.IsVisible>
                                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                        <Binding Path="$parent[ItemsControl].((vm:MainWindowViewModel)DataContext).IsLoadMode"/>
                                                        <Binding Path="IsOccupied"/>
                                                    </MultiBinding>
                                                </Button.IsVisible>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
            </Border>
            <!-- Settings -->
            <Border IsVisible="{Binding IsSettingsOpen}" Background="#E60B0D14">
                <Border Width="470" MaxHeight="600" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Background="#161A24" BorderBrush="#3A3F52" BorderThickness="2" CornerRadius="6" Padding="22">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                            <TextBlock Grid.Column="0" Text="Settings" FontSize="20" FontWeight="Bold"
                                       Foreground="#E8C56B" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Close" Command="{Binding CloseSettingsCommand}"/>
                        </Grid>
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="18">

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Reduced motion" Foreground="#E8E9F0"/>
                                <TextBlock Text="Stops the hanging storefront signs from swaying."
                                           Foreground="#9AA0B5" FontSize="11"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                          IsChecked="{Binding Settings.ReducedMotion}"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Autosave" Foreground="#E8E9F0"/>
                                <TextBlock Text="Saves automatically when you return to town."
                                           Foreground="#9AA0B5" FontSize="11"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                          IsChecked="{Binding Settings.Autosave}"/>
                        </Grid>

                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Interface size" Foreground="#E8E9F0"/>
                                <TextBlock Grid.Column="1" Foreground="#9AA0B5"
                                           Text="{Binding Settings.UiScale, StringFormat='{}{0:P0}'}"/>
                            </Grid>
                            <Slider Minimum="0.8" Maximum="1.6" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    Value="{Binding Settings.UiScale}"/>
                            <TextBlock Text="Enlarges all text and controls — up to 160% for easier reading."
                                       Foreground="#9AA0B5" FontSize="11"/>
                        </StackPanel>

                        <Border Height="1" Background="#2A2F3E" Margin="0,4"/>
                        <TextBlock Text="Accessibility" Foreground="#E8C56B" FontWeight="Bold"/>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Colourblind-friendly combat log" Foreground="#E8E9F0"/>
                                <TextBlock Text="Recolours the combat log to avoid red/green pairings (icons still mark every event)."
                                           Foreground="#9AA0B5" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                          IsChecked="{Binding Settings.ColorblindMode}"/>
                        </Grid>

                        <TextBlock Text="Movement keys (the arrow keys always work too)" Foreground="#E8E9F0"/>
                        <UniformGrid Columns="2" Margin="0,2,0,0">
                            <StackPanel Margin="0,0,8,6">
                                <TextBlock Text="Forward" Foreground="#9AA0B5" FontSize="11"/>
                                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding BindableKeys}"
                                          SelectedItem="{Binding Settings.MoveForwardKey}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Text="Back" Foreground="#9AA0B5" FontSize="11"/>
                                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding BindableKeys}"
                                          SelectedItem="{Binding Settings.MoveBackwardKey}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Turn left" Foreground="#9AA0B5" FontSize="11"/>
                                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding BindableKeys}"
                                          SelectedItem="{Binding Settings.TurnLeftKey}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Turn right" Foreground="#9AA0B5" FontSize="11"/>
                                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding BindableKeys}"
                                          SelectedItem="{Binding Settings.TurnRightKey}"/>
                            </StackPanel>
                        </UniformGrid>
                        <Border Height="1" Background="#2A2F3E" Margin="0,4"/>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Mute everything" Foreground="#E8E9F0"/>
                                <TextBlock Text="Silences all sound effects and music." Foreground="#9AA0B5" FontSize="11"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                          IsChecked="{Binding Settings.Muted}"/>
                        </Grid>

                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Sound effects volume" Foreground="#E8E9F0"/>
                                <TextBlock Grid.Column="1" FontWeight="Bold" Foreground="#E8C56B"
                                           Text="{Binding Settings.SoundVolume, StringFormat='{}{0:P0}'}"/>
                            </Grid>
                            <Slider Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    Value="{Binding Settings.SoundVolume}"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Background music" Foreground="#E8E9F0"/>
                                <TextBlock Text="Plays looping music in town, the dungeon and combat."
                                           Foreground="#9AA0B5" FontSize="11"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                          IsChecked="{Binding Settings.MusicEnabled}"/>
                        </Grid>

                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Background music volume" Foreground="#E8E9F0"/>
                                <TextBlock Grid.Column="1" FontWeight="Bold" Foreground="#E8C56B"
                                           Text="{Binding Settings.MusicVolume, StringFormat='{}{0:P0}'}"/>
                            </Grid>
                            <Slider Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    Value="{Binding Settings.MusicVolume}"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Crossfade music" Foreground="#E8E9F0"/>
                                <TextBlock Text="Smoothly fade between tracks on a scene change instead of a hard cut."
                                           Foreground="#9AA0B5" FontSize="11"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                          IsChecked="{Binding Settings.CrossfadeMusic}"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Difficulty" Foreground="#E8E9F0"/>
                                <TextBlock Text="Sets foe toughness, ambush frequency, camp risk and rewards for a new run. Applies before you next descend."
                                           Foreground="#9AA0B5" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" VerticalAlignment="Center" MinWidth="120"
                                      ItemsSource="{Binding DifficultyOptions}"
                                      SelectedItem="{Binding Settings.Difficulty}"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Ironman mode (permadeath)" Foreground="#E8E9F0"/>
                                <TextBlock Text="A new run becomes Ironman: a total party kill wipes the save for good, and manual save/load is disabled. Applies before you next descend."
                                           Foreground="#9AA0B5" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                          IsChecked="{Binding Settings.IronmanMode}"/>
                        </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Border>

            <!-- Quest journal -->
            <Border IsVisible="{Binding IsQuestLogOpen}" Background="#E60B0D14">
                <Border Width="580" MaxHeight="660" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Background="#161A24" BorderBrush="#3A3F52" BorderThickness="2" CornerRadius="6" Padding="20">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                            <TextBlock Grid.Column="0" Text="📜 Quest Journal" FontSize="20" FontWeight="Bold"
                                       Foreground="#E8C56B" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Close" Command="{Binding CloseQuestLogCommand}"/>
                        </Grid>
                        <TextBlock DockPanel.Dock="Bottom" Margin="0,12,0,0" FontSize="11" Foreground="#7E879B"
                                   Text="Press J to open or close the journal. Quests are turned in at the giver — Garth's Shoppe or a tavern."/>
                        <ScrollViewer>
                            <StackPanel>
                                <TextBlock IsVisible="{Binding !QuestLog.HasQuests}" TextWrapping="Wrap"
                                           Foreground="#9AA0B5" FontSize="13" Margin="2,8"
                                           Text="{Binding QuestLog.EmptyMessage}"/>
                                <ItemsControl ItemsSource="{Binding QuestLog.Quests}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:QuestEntryViewModel">
                                            <Border Margin="0,0,0,10" Padding="12,10" CornerRadius="4" Background="#222634"
                                                    BorderThickness="1.5" BorderBrush="{Binding AccentBrush}">
                                                <StackPanel Spacing="3">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="Bold"
                                                                   Foreground="#E8E9F0" FontSize="14"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11"
                                                                   FontWeight="Bold" Foreground="{Binding StatusBrush}"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding GiverLine}" FontSize="11" Foreground="#9AA0B5"/>
                                                    <TextBlock Text="{Binding Objective}" FontSize="12" Foreground="#C7CBDA"
                                                               FontFamily="Consolas,monospace"/>
                                                    <TextBlock Text="{Binding RewardLine}" FontSize="12" Foreground="#D8C58A"/>
                                                    <Panel Margin="0,2,0,0">
                                                        <!-- Normal: turn-in hint + Abandon -->
                                                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding !ConfirmingAbandon}">
                                                            <TextBlock Grid.Column="0" Text="{Binding TurnInHint}" FontSize="11"
                                                                       Foreground="#8FB7FF" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                            <Button Grid.Column="1" Content="Abandon" FontSize="11" Padding="9,3"
                                                                    Margin="8,0,0,0" VerticalAlignment="Top"
                                                                    Background="#3A2630" Foreground="#E0A8B0"
                                                                    Command="{Binding RequestAbandonCommand}"/>
                                                        </Grid>
                                                        <!-- Confirm: forfeit progress? -->
                                                        <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding ConfirmingAbandon}">
                                                            <TextBlock Grid.Column="0" Text="Forfeit this quest's progress?" FontSize="11"
                                                                       Foreground="#E0A8B0" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                            <Button Grid.Column="1" Content="Yes, abandon" FontSize="11" Padding="9,3"
                                                                    Margin="8,0,0,0" Background="#5A2630" Foreground="#FFD8DE" FontWeight="Bold"
                                                                    Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).AbandonQuestCommand}"
                                                                    CommandParameter="{Binding}"/>
                                                            <Button Grid.Column="2" Content="Keep" FontSize="11" Padding="9,3"
                                                                    Margin="6,0,0,0" Command="{Binding CancelAbandonCommand}"/>
                                                        </Grid>
                                                    </Panel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Border>

            <!-- Bestiary -->
            <Border IsVisible="{Binding IsBestiaryOpen}" Background="#E60B0D14">
                <Border Width="600" MaxHeight="680" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Background="#161A24" BorderBrush="#3A3F52" BorderThickness="2" CornerRadius="6" Padding="20">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                            <TextBlock Grid.Column="0" Text="{Binding Bestiary.Heading}" FontSize="20" FontWeight="Bold"
                                       Foreground="#E8C56B" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Close" Command="{Binding CloseBestiaryCommand}"/>
                        </Grid>
                        <TextBlock DockPanel.Dock="Bottom" Margin="0,12,0,0" FontSize="11" Foreground="#7E879B"
                                   Text="Press B to open or close the bestiary. Entries fill in as you face each monster."/>
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Bestiary.Entries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BestiaryEntryViewModel">
                                        <Border Margin="0,0,0,8" Padding="12,9" CornerRadius="4" Background="#222634">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"
                                                           Foreground="{Binding NameBrush}"/>
                                                <TextBlock Text="{Binding Lore}" IsVisible="{Binding IsDiscovered}" FontSize="12"
                                                           FontStyle="Italic" Foreground="#B8C0A8" TextWrapping="Wrap"
                                                           Margin="0,1,0,3"/>
                                                <TextBlock Text="{Binding StatLine}" FontSize="12" Foreground="#C7CBDA"
                                                           FontFamily="Consolas,monospace" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Notes}" IsVisible="{Binding HasNotes}" FontSize="12"
                                                           Foreground="#D69FC4" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Affinities}" IsVisible="{Binding HasAffinities}"
                                                           FontSize="12" Foreground="#6FD0E8" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding DropHint}" IsVisible="{Binding IsDiscovered}"
                                                           FontSize="12" Foreground="#C9A24B" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Worth}" IsVisible="{Binding IsDiscovered}"
                                                           FontSize="11" Foreground="#D8C58A"/>
                                                <TextBlock Text="{Binding TallyLine}" IsVisible="{Binding IsDiscovered}"
                                                           FontSize="11" Foreground="#8FB7FF"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Border>

            <!-- Accessory-set codex -->
            <Border IsVisible="{Binding IsSetCodexOpen}" Background="#E60B0D14">
                <Border Width="600" MaxHeight="680" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Background="#161A24" BorderBrush="#3A3F52" BorderThickness="2" CornerRadius="6" Padding="20">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                            <TextBlock Grid.Column="0" Text="{Binding SetCodex.Heading}" FontSize="20" FontWeight="Bold"
                                       Foreground="#E8C56B" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Close" Command="{Binding CloseSetCodexCommand}"/>
                        </Grid>
                        <TextBlock DockPanel.Dock="Bottom" Margin="0,12,0,0" FontSize="11" Foreground="#7E879B"
                                   Text="Press K to open or close. Equip a hero's matched pieces to activate a set's bonus."/>
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding SetCodex.Entries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SetCodexEntryViewModel">
                                        <Border Margin="0,0,0,8" Padding="12,9" CornerRadius="4" Background="#222634">
                                            <StackPanel Spacing="2">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" FontSize="14"
                                                               Foreground="{Binding NameBrush}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="11"
                                                               Foreground="{Binding StatusBrush}" VerticalAlignment="Center"/>
                                                </Grid>
                                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#C7CBDA"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Pieces}" FontSize="12" Foreground="#9AA0B5"
                                                           FontFamily="Consolas,monospace" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Bonus}" FontSize="12" Foreground="#C9A24B"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Source}" FontSize="11" Foreground="#8FB7FF"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Border>

            <!-- Achievements & renown -->
            <Border IsVisible="{Binding IsAchievementsOpen}" Background="#E60B0D14">
                <Border Width="600" MaxHeight="680" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Background="#161A24" BorderBrush="#3A3F52" BorderThickness="2" CornerRadius="6" Padding="20">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                            <TextBlock Grid.Column="0" Text="🏆 Achievements" FontSize="20" FontWeight="Bold"
                                       Foreground="#E8C56B" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Close" Command="{Binding CloseAchievementsCommand}"/>
                        </Grid>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding Achievements.Heading}" FontSize="12"
                                   Foreground="#9BE89B" Margin="0,0,0,12"/>
                        <TextBlock DockPanel.Dock="Bottom" Margin="0,12,0,0" FontSize="11" Foreground="#7E879B"
                                   Text="Renown earns goodwill — a discount on the temple, inn, smith and trainer that grows as you achieve more."/>
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Achievements.Entries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AchievementEntryViewModel">
                                        <Border Margin="0,0,0,7" Padding="12,9" CornerRadius="4" Background="#222634"
                                                Opacity="{Binding Opacity}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"
                                                               Foreground="{Binding NameBrush}"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#9AA0B5"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding RenownText}" FontWeight="Bold"
                                                           VerticalAlignment="Center" Foreground="{Binding RenownBrush}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Border>

            <!-- Side-quest offer -->
            <Border IsVisible="{Binding Town.IsQuestOfferOpen, FallbackValue=false}" Background="#E60B0D14">
                <Border Width="480" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Background="#1A1626" BorderBrush="#E8C56B" BorderThickness="2" CornerRadius="8" Padding="22">
                    <StackPanel Spacing="12">
                        <TextBlock Text="A Proposition" FontSize="20" FontWeight="Bold" Foreground="#E8C56B"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Town.OfferGiverName}" FontSize="13" Foreground="#9AA0B5"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Town.OfferPitch}" TextWrapping="Wrap" Foreground="#E8E9F0" FontSize="14"/>
                        <Border Background="#222634" CornerRadius="4" Padding="10">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{Binding Town.OfferTitle}" FontWeight="Bold" Foreground="#D8C58A"/>
                                <TextBlock Text="{Binding Town.OfferReward}" Foreground="#9BE89B" FontSize="12"/>
                                <TextBlock Text="{Binding Town.OfferTurnIn}" Foreground="#8FB7FF" FontSize="11"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                            <Button Grid.Column="0" Content="Accept" Command="{Binding Town.AcceptQuestOfferCommand}"
                                    HorizontalAlignment="Stretch" Margin="0,0,5,0" Padding="0,8"
                                    Background="#3A5A3A" Foreground="#E9FFE0" FontWeight="Bold"
                                    HorizontalContentAlignment="Center"/>
                            <Button Grid.Column="1" Content="Decline" Command="{Binding Town.DeclineQuestOfferCommand}"
                                    HorizontalAlignment="Stretch" Margin="5,0,0,0" Padding="0,8"
                                    HorizontalContentAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>
        </Panel>
    </Grid>
    </LayoutTransformControl>
</UserControl>
