<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BardsTale.UI.ViewModels"
             xmlns:controls="using:BardsTale.UI.Controls"
             xmlns:core="using:BardsTale.Core.Characters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1060" d:DesignHeight="660"
             x:Class="BardsTale.UI.Views.TownView"
             x:DataType="vm:TownViewModel">

    <Grid ColumnDefinitions="*,320" RowDefinitions="*,Auto">

        <!-- Overworld view + building overlay -->
        <Border Grid.Row="0" Grid.Column="0" Margin="0,0,12,0"
                BorderBrush="#3A3F52" BorderThickness="2" CornerRadius="4"
                Background="Black" ClipToBounds="True">
            <Panel>
                <controls:DungeonView
                    Maze="{Binding Maze}" PartyX="{Binding PartyX}" PartyY="{Binding PartyY}"
                    Facing="{Binding Facing}" Revision="{Binding Revision}"
                    Buildings="{Binding Buildings}"/>

                <Border VerticalAlignment="Top" HorizontalAlignment="Stretch" Background="#AA000000" Padding="8,4">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding BannerText}" Foreground="#CFE8FF"
                                   FontFamily="Consolas,monospace"/>
                        <TextBlock Grid.Column="1" Text="{Binding GoldText}" Foreground="#E8C56B"
                                   FontFamily="Consolas,monospace"/>
                    </Grid>
                </Border>

                <!-- Building interior overlay -->
                <Border IsVisible="{Binding IsInBuilding}" Background="#F00B0D14" Padding="14">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                            <TextBlock Grid.Column="0" Text="{Binding CurrentBuildingName}" FontSize="20"
                                       FontWeight="Bold" Foreground="#E8C56B"/>
                            <Button Grid.Column="1" Content="Leave (Esc)" Command="{Binding LeaveCommand}"/>
                        </Grid>

                        <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="8" CornerRadius="4"
                                Background="#0E1018">
                            <TextBlock Text="{Binding Notice}" Foreground="#A9D0B0"
                                       FontFamily="Consolas,monospace" TextWrapping="Wrap"/>
                        </Border>

                        <Panel>
                            <!-- Adventurers Guild -->
                            <Grid IsVisible="{Binding IsGuild}" ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Margin="0,0,12,0" Spacing="8">
                                    <TextBlock Text="Create a Hero" Foreground="#9AA0B5"/>
                                    <TextBox Watermark="Name" Text="{Binding Creation.Name, Mode=TwoWay}"/>
                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Race" VerticalAlignment="Center"
                                                   Foreground="#C7CBDA" Margin="0,0,8,4"/>
                                        <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,4" HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding Creation.Races}"
                                                  SelectedItem="{Binding Creation.SelectedRace, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="core:RaceDefinition">
                                                    <TextBlock Text="{Binding Name}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Class" VerticalAlignment="Center"
                                                   Foreground="#C7CBDA" Margin="0,0,8,0"/>
                                        <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding Creation.Classes}"
                                                  SelectedItem="{Binding Creation.SelectedClass, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="core:ClassDefinition">
                                                    <TextBlock Text="{Binding Name}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Content="Roll Attributes" Command="{Binding Creation.RollCommand}"/>
                                        <Button Content="Recruit" Command="{Binding RecruitCommand}"
                                                IsEnabled="{Binding Creation.HasCandidate}"/>
                                    </StackPanel>
                                    <Border IsVisible="{Binding Creation.HasCandidate}" Padding="10" CornerRadius="4"
                                            Background="#1C2030">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Creation.PreviewName}" FontWeight="Bold" Foreground="#E8E9F0"/>
                                            <TextBlock Text="{Binding Creation.PreviewClassLine}" FontSize="11" Foreground="#9AA0B5"/>
                                            <UniformGrid Columns="5" Margin="0,6,0,0">
                                                <StackPanel><TextBlock Text="ST" Foreground="#8FB7FF" FontSize="10"/><TextBlock Text="{Binding Creation.PreviewStrength}" Foreground="#E8E9F0"/></StackPanel>
                                                <StackPanel><TextBlock Text="IQ" Foreground="#8FB7FF" FontSize="10"/><TextBlock Text="{Binding Creation.PreviewIntelligence}" Foreground="#E8E9F0"/></StackPanel>
                                                <StackPanel><TextBlock Text="DX" Foreground="#8FB7FF" FontSize="10"/><TextBlock Text="{Binding Creation.PreviewDexterity}" Foreground="#E8E9F0"/></StackPanel>
                                                <StackPanel><TextBlock Text="CN" Foreground="#8FB7FF" FontSize="10"/><TextBlock Text="{Binding Creation.PreviewConstitution}" Foreground="#E8E9F0"/></StackPanel>
                                                <StackPanel><TextBlock Text="LK" Foreground="#8FB7FF" FontSize="10"/><TextBlock Text="{Binding Creation.PreviewLuck}" Foreground="#E8E9F0"/></StackPanel>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>
                                    <Button Content="Quick Party (Q)" Command="{Binding QuickPartyCommand}"
                                            HorizontalAlignment="Stretch"/>
                                </StackPanel>

                                <DockPanel Grid.Column="1">
                                    <TextBlock DockPanel.Dock="Top" Text="Current Party" Foreground="#9AA0B5" Margin="0,0,0,6"/>
                                    <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="10" CornerRadius="4"
                                            Background="#1C2030">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Train (change class)" Foreground="#9AA0B5"/>
                                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Hero" VerticalAlignment="Center"
                                                           Foreground="#C7CBDA" Margin="0,0,8,4"/>
                                                <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,4" HorizontalAlignment="Stretch"
                                                          ItemsSource="{Binding Party}" SelectedItem="{Binding SelectedHero, Mode=TwoWay}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:CharacterViewModel">
                                                            <TextBlock Text="{Binding Name}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="New class" VerticalAlignment="Center"
                                                           Foreground="#C7CBDA" Margin="0,0,8,0"/>
                                                <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                                                          ItemsSource="{Binding ChangeableClasses}"
                                                          SelectedItem="{Binding SelectedNewClass, Mode=TwoWay}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="core:ClassDefinition">
                                                            <TextBlock Text="{Binding Name}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </Grid>
                                            <TextBlock Text="{Binding ChangeClassInfo}" FontSize="11" Foreground="#9AA0B5"
                                                       TextWrapping="Wrap"/>
                                            <Button Content="Change Class" Command="{Binding ChangeClassCommand}"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ScrollViewer>
                                        <ItemsControl ItemsSource="{Binding Party}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:CharacterViewModel">
                                                    <Border Margin="0,0,0,6" Padding="8,6" CornerRadius="4" Background="#222634">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#E8E9F0"/>
                                                                <TextBlock Text="{Binding ClassLine}" FontSize="11" Foreground="#9AA0B5"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Content="Dismiss" VerticalAlignment="Center"
                                                                    Command="{Binding $parent[ItemsControl].((vm:TownViewModel)DataContext).DismissCommand}"
                                                                    CommandParameter="{Binding}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Grid>

                            <!-- Garth's Equipment Shoppe -->
                            <Grid IsVisible="{Binding IsShop}" ColumnDefinitions="*,260">
                                <Grid Grid.Column="0" Margin="0,0,12,0" RowDefinitions="*,*">
                                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                        <TextBlock DockPanel.Dock="Top" Text="Wares for sale" Foreground="#9AA0B5" Margin="0,0,0,6"/>
                                        <ListBox ItemsSource="{Binding Stock}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                                 Background="#181B24">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ShopItemViewModel">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{Binding NameBrush}"/>
                                                            <TextBlock Text="{Binding StatsText}" FontSize="11" Foreground="#9AA0B5"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding PriceText}" Foreground="#E8C56B"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                    <DockPanel Grid.Row="1">
                                        <TextBlock DockPanel.Dock="Top" Text="Your stash (found gear)" Foreground="#9AA0B5" Margin="0,0,0,6"/>
                                        <ListBox ItemsSource="{Binding Stash}" SelectedItem="{Binding SelectedStashItem, Mode=TwoWay}"
                                                 Background="#181B24">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ShopItemViewModel">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{Binding NameBrush}"/>
                                                        <TextBlock Text="{Binding StatsText}" FontSize="11" Foreground="#9AA0B5"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </Grid>
                                <StackPanel Grid.Column="1" Spacing="8">
                                    <TextBlock Text="Hero" Foreground="#9AA0B5"/>
                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Party}"
                                              SelectedItem="{Binding SelectedHero, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CharacterViewModel">
                                                <TextBlock Text="{Binding Name}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Border Padding="8" CornerRadius="4" Background="#1C2030"
                                            IsVisible="{Binding SelectedHero, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding SelectedHero.Name}" FontWeight="Bold" Foreground="#E8E9F0"/>
                                            <TextBlock Text="{Binding SelectedHero.GearText}" FontSize="11" Foreground="#9AA0B5" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding SelectedHero.ArmorClassText}" FontSize="11" Foreground="#9AA0B5"/>
                                            <TextBlock Text="{Binding SelectedHero.WardText}" FontSize="11" Foreground="#6FD0E8"
                                                       IsVisible="{Binding SelectedHero.HasWards}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <Button Content="Buy &amp; Equip selected ware" Command="{Binding BuyCommand}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                    <Button Content="Appraise — Garth (100 gold)" Command="{Binding IdentifyCommand}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                    <Button Content="Appraise — Rogue (free)" Command="{Binding IdentifyWithRogueCommand}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                    <Button Content="Appraise — Scrye Sight" Command="{Binding IdentifyWithMagicCommand}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                    <Button Content="Equip from stash" Command="{Binding EquipFromStashCommand}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                    <Button Content="Sell selected (½ value)" Command="{Binding SellStashItemCommand}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Temple -->
                            <StackPanel IsVisible="{Binding IsTemple}" Spacing="10">
                                <Button Content="Heal the entire party" Command="{Binding HealPartyCommand}"/>
                                <TextBlock Text="Fallen Companions" Foreground="#9AA0B5" Margin="0,6,0,0"/>
                                <ItemsControl ItemsSource="{Binding Party}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CharacterViewModel">
                                            <Border Margin="0,0,0,6" Padding="8,6" CornerRadius="4" Background="#222634"
                                                    IsVisible="{Binding IsDead}">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="#C0566B"
                                                               Text="{Binding Name}"/>
                                                    <Button Grid.Column="1" Content="Resurrect"
                                                            Command="{Binding $parent[ItemsControl].((vm:TownViewModel)DataContext).ResurrectCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Drained Companions" Foreground="#9AA0B5" Margin="0,6,0,0"/>
                                <ItemsControl ItemsSource="{Binding Party}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CharacterViewModel">
                                            <Border Margin="0,0,0,6" Padding="8,6" CornerRadius="4" Background="#222634"
                                                    IsVisible="{Binding IsDrained}">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" Foreground="#B98CD8"/>
                                                        <TextBlock Text="{Binding DrainedText}" FontSize="11" Foreground="#9AA0B5"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="{Binding RestoreCostText}"
                                                            Command="{Binding $parent[ItemsControl].((vm:TownViewModel)DataContext).RestoreLevelsCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Withered Companions" Foreground="#9AA0B5" Margin="0,6,0,0"/>
                                <ItemsControl ItemsSource="{Binding Party}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CharacterViewModel">
                                            <Border Margin="0,0,0,6" Padding="8,6" CornerRadius="4" Background="#222634"
                                                    IsVisible="{Binding IsStatDrained}">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" Foreground="#C8A06B"/>
                                                        <TextBlock Text="{Binding DrainedStatsText}" FontSize="11" Foreground="#9AA0B5"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="{Binding RestoreStatsCostText}"
                                                            Command="{Binding $parent[ItemsControl].((vm:TownViewModel)DataContext).RestoreStatsCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Review Board -->
                            <StackPanel IsVisible="{Binding IsReview}" Spacing="10">
                                <ItemsControl ItemsSource="{Binding Party}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CharacterViewModel">
                                            <Border Margin="0,0,0,6" Padding="8,6" CornerRadius="4" Background="#222634">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#E8E9F0"/>
                                                        <TextBlock Text="{Binding ExperienceText}" FontSize="11" Foreground="#9AA0B5"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="Advance" VerticalAlignment="Center"
                                                            IsEnabled="{Binding CanLevelUp}"
                                                            Command="{Binding $parent[ItemsControl].((vm:TownViewModel)DataContext).AdvanceCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Tavern -->
                            <DockPanel IsVisible="{Binding IsTavern}">
                                <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
                                    <TextBlock TextWrapping="Wrap" Foreground="#C7CBDA"
                                               Text="The fire crackles and the regulars lean in. Buy a round and they might let something slip."/>
                                    <Button Content="Buy a round (5 gold)" Command="{Binding BuyRoundCommand}"
                                            HorizontalAlignment="Left"/>
                                    <TextBlock Text="Rumours" Foreground="#9AA0B5"/>
                                </StackPanel>
                                <ScrollViewer>
                                    <ItemsControl ItemsSource="{Binding TavernRumors}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Foreground="#D8C58A" FontStyle="Italic"
                                                           TextWrapping="Wrap" Margin="0,0,0,6"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>

                            <!-- Garrick's Inn -->
                            <StackPanel IsVisible="{Binding IsInn}" Spacing="10">
                                <TextBlock TextWrapping="Wrap" Foreground="#C7CBDA"
                                           Text="A warm hearth and soft beds. A night's rest fully restores the party's hit points and spell points (the fallen still need the Temple)."/>
                                <Button Command="{Binding RestCommand}" HorizontalAlignment="Left">
                                    <TextBlock>
                                        <Run Text="Rest for the night ("/><Run Text="{Binding RestCost}"/><Run Text=" gold)"/>
                                    </TextBlock>
                                </Button>
                            </StackPanel>

                            <!-- The Notice Board -->
                            <DockPanel IsVisible="{Binding IsQuestBoard}">
                                <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#C7CBDA" Margin="0,0,0,8"
                                           Text="Notices from around Skara Brae. Take any that suit you — your journal holds up to five at once (press J to review them), and fresh notices go up after each trip into the catacombs."/>
                                <ScrollViewer>
                                    <ItemsControl ItemsSource="{Binding Postings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:QuestBoardItemViewModel">
                                                <Border Margin="0,0,0,10" Padding="12,10" CornerRadius="4" Background="#222634"
                                                        BorderThickness="1.5" BorderBrush="#2E6A6A">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <StackPanel Grid.Column="0" Spacing="2">
                                                            <TextBlock Text="{Binding Title}" FontWeight="Bold"
                                                                       Foreground="#E8E9F0" FontSize="14"/>
                                                            <TextBlock Text="{Binding GiverLine}" FontSize="11" Foreground="#9AA0B5"/>
                                                            <TextBlock Text="{Binding Pitch}" FontSize="12" Foreground="#C7CBDA"
                                                                       TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding RewardLine}" FontSize="12" Foreground="#D8C58A"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="Accept" VerticalAlignment="Center"
                                                                Margin="10,0,0,0" Padding="14,6" Background="#3A5A3A"
                                                                Foreground="#E9FFE0" FontWeight="Bold"
                                                                Command="{Binding $parent[ItemsControl].((vm:TownViewModel)DataContext).AcceptPostingCommand}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>

                            <!-- The Forge (Smithy) -->
                            <DockPanel IsVisible="{Binding IsSmithy}">
                                <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
                                    <TextBlock TextWrapping="Wrap" Foreground="#C7CBDA"
                                               Text="The forge roars. Bring gold and forge embers (won from deep foes) and the smith will hammer a finer edge onto your gear — up to +3."/>
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Grid.Column="0" Text="{Binding ForgeEmbersText}" FontWeight="Bold"
                                                   Foreground="#E8A05A" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" HorizontalAlignment="Right" MinWidth="160"
                                                  ItemsSource="{Binding Party}" SelectedItem="{Binding SelectedHero, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:CharacterViewModel">
                                                    <TextBlock Text="{Binding Name}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                                <ScrollViewer>
                                    <ItemsControl ItemsSource="{Binding Upgrades}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:GearUpgradeViewModel">
                                                <Border Margin="0,0,0,8" Padding="12,9" CornerRadius="4" Background="#222634"
                                                        BorderThickness="1.5" BorderBrush="#5A3A2A">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <StackPanel Grid.Column="0" Spacing="2">
                                                            <TextBlock Text="{Binding Line}" FontWeight="Bold" Foreground="#E8E9F0"/>
                                                            <TextBlock Text="{Binding UpgradeLabel}" FontSize="12" Foreground="#E8C56B"/>
                                                            <TextBlock Text="{Binding CostText}" FontSize="11" Foreground="#9AA0B5"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="Forge" VerticalAlignment="Center"
                                                                Margin="10,0,0,0" Padding="14,6" Background="#7A4A2A"
                                                                Foreground="#FFE9D8" FontWeight="Bold"
                                                                IsVisible="{Binding CanUpgrade}"
                                                                Command="{Binding $parent[ItemsControl].((vm:TownViewModel)DataContext).UpgradeGearCommand}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>

                            <!-- Skara Brae Bank -->
                            <StackPanel IsVisible="{Binding IsBank}" Spacing="10">
                                <TextBlock TextWrapping="Wrap" Foreground="#C7CBDA"
                                           Text="Deposit your gold for safekeeping — coin in the vault can't be filched by cutpurses in the catacombs. Withdraw it when you need to spend."/>
                                <Grid ColumnDefinitions="*,*">
                                    <TextBlock Grid.Column="0" Foreground="#E8C56B" FontWeight="Bold">
                                        <Run Text="Purse: "/><Run Text="{Binding GoldText}"/>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Text="{Binding BankedGoldText}" Foreground="#9BE89B"
                                               FontWeight="Bold"/>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0" Text="Amount" VerticalAlignment="Center"
                                               Foreground="#C7CBDA" Margin="0,0,8,0"/>
                                    <NumericUpDown Grid.Column="1" Minimum="0" Increment="100" FormatString="0"
                                                   Value="{Binding BankAmount, Mode=TwoWay}"/>
                                </Grid>
                                <UniformGrid Columns="2">
                                    <Button Content="Deposit" Command="{Binding DepositCommand}" Margin="0,0,4,6"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                    <Button Content="Withdraw" Command="{Binding WithdrawCommand}" Margin="4,0,0,6"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                    <Button Content="Deposit all" Command="{Binding DepositAllCommand}" Margin="0,0,4,0"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                    <Button Content="Withdraw all" Command="{Binding WithdrawAllCommand}" Margin="4,0,0,0"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                </UniformGrid>
                            </StackPanel>
                        </Panel>
                    </DockPanel>
                </Border>

                <!-- Town spell menu overlay -->
                <Border IsVisible="{Binding IsSpellMenuOpen}" Background="#F00B0D14" Padding="14">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                            <TextBlock Grid.Column="0" Text="Cast a Spell" FontSize="20" FontWeight="Bold"
                                       Foreground="#E8C56B"/>
                            <Button Grid.Column="1" Content="Close" Command="{Binding CloseSpellMenuCommand}"/>
                        </Grid>

                        <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="8" CornerRadius="4"
                                Background="#0E1018">
                            <TextBlock Text="{Binding Notice}" Foreground="#A9D0B0"
                                       FontFamily="Consolas,monospace" TextWrapping="Wrap"/>
                        </Border>

                        <StackPanel DockPanel.Dock="Right" Width="220" Margin="12,0,0,0" Spacing="8">
                            <TextBlock Text="Target (for single-ally spells)" Foreground="#9AA0B5" FontSize="12"/>
                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Party}"
                                      SelectedItem="{Binding SelectedHero, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CharacterViewModel">
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Border Padding="8" CornerRadius="4" Background="#1C2030"
                                    IsVisible="{Binding SelectedHero, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding SelectedHero.Name}" FontWeight="Bold" Foreground="#E8E9F0"/>
                                    <TextBlock Text="{Binding SelectedHero.Health}" FontSize="11" Foreground="#9AA0B5"/>
                                    <TextBlock Text="{Binding SelectedHero.StatusText}" FontSize="11" Foreground="#9AA0B5"/>
                                </StackPanel>
                            </Border>
                            <Button Content="Cast" Command="{Binding CastTownSpellCommand}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        </StackPanel>

                        <ListBox ItemsSource="{Binding SpellMenu}" SelectedItem="{Binding SelectedSpell, Mode=TwoWay}"
                                 Background="#181B24">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:SpellMenuItemViewModel">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" FontWeight="Bold" Foreground="#E8E9F0"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#9AA0B5"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Panel>
        </Border>

        <!-- Right column: roster + minimap + legend -->
        <Grid Grid.Row="0" Grid.Column="1" RowDefinitions="*,Auto,Auto">
            <Border Grid.Row="0" BorderBrush="#3A3F52" BorderThickness="1" CornerRadius="4"
                    Background="#181B24" Padding="6">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Party}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CharacterViewModel">
                                <Border Margin="0,0,0,6" Padding="8,6" CornerRadius="4"
                                        Background="#222634" BorderBrush="#333A4D" BorderThickness="1">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}"
                                                   FontWeight="Bold" Foreground="#E8E9F0"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding StatusText}"
                                                   FontSize="11" FontWeight="Bold" Foreground="{Binding StatusBrush}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                   Text="{Binding ClassLine}" FontSize="11" Foreground="#9AA0B5"/>
                                        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                              ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0">
                                            <TextBlock Grid.Column="0" Text="HP" FontSize="11" Foreground="#C0566B" Margin="0,0,6,0"/>
                                            <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding HealthFraction}"
                                                         Foreground="#C0566B" Height="10"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Health}" FontSize="11"
                                                       Foreground="#C7CBDA" Margin="6,0,0,0"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Border Grid.Row="1" Margin="0,8,0,0" Height="220" BorderBrush="#3A3F52" BorderThickness="1"
                    CornerRadius="4" Background="#0E1018" Padding="6">
                <controls:MiniMap Maze="{Binding Maze}" PartyX="{Binding PartyX}" PartyY="{Binding PartyY}"
                                  Facing="{Binding Facing}" Revision="{Binding Revision}" RevealAll="True"
                                  Buildings="{Binding Buildings}"/>
            </Border>

            <!-- Map legend: one swatch per building type -->
            <ItemsControl Grid.Row="2" Margin="2,6,0,0" ItemsSource="{Binding MapLegend}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="controls:BuildingMarker">
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,10,4">
                            <Border Width="15" Height="15" CornerRadius="3" Background="{Binding Background}">
                                <TextBlock Text="{Binding Glyph}" Foreground="{Binding Foreground}"
                                           FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding Label}" Foreground="#9AA0B5" FontSize="11"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- Bottom: movement controls -->
        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="#9AA0B5"
                       Text="Move with the on-screen arrows (or WASD), then step onto a building to enter it."/>
            <StackPanel Grid.Column="1" Width="320">
                <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto">
                    <Button Grid.Row="0" Grid.Column="1" Content="▲ Fwd" Command="{Binding MoveForwardCommand}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="2"/>
                    <Button Grid.Row="1" Grid.Column="0" Content="◄ Turn" Command="{Binding TurnLeftCommand}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="2"/>
                    <Button Grid.Row="1" Grid.Column="1" Content="▼ Back" Command="{Binding MoveBackwardCommand}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="2"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="Turn ►" Command="{Binding TurnRightCommand}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="2"/>
                </Grid>
                <Button Content="Enter Building" Command="{Binding EnterCommand}" Margin="2,4,2,0"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Background="#3A5A3A" Foreground="#E9FFE0"/>
                <Button Content="Cast a Spell" Command="{Binding OpenSpellMenuCommand}" Margin="2,4,2,0"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
