<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Requires Xcode + the one-time workload:  sudo dotnet workload install ios
         If your installed ios workload targets .NET 10, change this to net10.0-ios. -->
    <TargetFramework>net9.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>13.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <ApplicationId>com.bardstale.app</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <!-- Silence the "net9.0-ios is out of support" notice on .NET 10 SDKs. -->
    <NoWarn>$(NoWarn);NETSDK1202</NoWarn>
  </PropertyGroup>

  <!-- Thin iOS head (iPad, landscape): just the entry point + an AVAudioPlayer backend.
       All UI lives in BardsTale.UI, which already supports the single-view lifetime and
       touch-first styling iOS uses. -->

  <ItemGroup>
    <PackageReference Include="Avalonia.iOS" Version="11.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BardsTale.UI\BardsTale.UI.csproj" />
  </ItemGroup>
</Project>
